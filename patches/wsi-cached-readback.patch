          void *mapped_memory = nullptr;
          if (image_data->external_mem.map_host_memory(&mapped_memory) == VK_SUCCESS && mapped_memory != nullptr)
          {
+            // The swapchain waits for GPU completion before invoking present_image.
+            // MapMemory covers the full allocation. Whole-size invalidation satisfies
+            // nonCoherentAtomSize alignment without assuming the image layout size.
+            VkMappedMemoryRange range = {};
+            range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+            range.memory = image_data->external_mem.get_host_memory();
+            range.offset = 0;
+            range.size = VK_WHOLE_SIZE;
+            VkResult invalidate_result = image_data->device_data->disp.InvalidateMappedMemoryRanges(
+               image_data->device_data->device, 1, &range);
+            if (invalidate_result != VK_SUCCESS)
+            {
+               WSI_LOG_ERROR("Cached readback invalidation failed: %d", invalidate_result);
+               return invalidate_result;
+            }
             const auto &vulkan_layout = image_data->external_mem.get_host_layout();
             size_t source_stride = vulkan_layout.rowPitch;
             size_t dest_stride = image_data->stride;
