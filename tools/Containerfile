RUN dpkg --add-architecture armhf && dpkg --add-architecture arm64 && apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates git cmake make gcc g++ gcc-arm-linux-gnueabihf g++-arm-linux-gnueabihf gcc-aarch64-linux-gnu g++-aarch64-linux-gnu patchelf squashfs-tools e2fsprogs pkg-config glslc xxd libdrm-dev:armhf libwayland-dev:armhf wayland-protocols libxcb-dri3-dev:armhf libxcb-present-dev:armhf libxcb-shm0-dev:armhf libxcb-sync-dev:armhf libxcb-xfixes0-dev:armhf libx11-dev:armhf libx11-xcb-dev:armhf libxrandr-dev:armhf libx11-dev:arm64 && rm -rf /var/lib/apt/lists/*
WORKDIR /project
CMD ["python3", "tools/build-in-container.py"]
